    "prism-react-renderer": "^2.4.1",
    "qrcode": "^1.5.4",
    "qs": "^6.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "remeda": "^2.42.0",
